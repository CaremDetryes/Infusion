filters:
  and:
    - file.folder.startsWith("Latos - Infusion/Infusion/Ressources/Compétence")
    - file.name != "All"
views:
  - type: table
    name: Tableau
    groupBy:
      property: Domaine de compétence
      direction: ASC
    order:
      - file.name
      - Outils ?
      - Attribut(s)
    sort:
      - property: file.ctime
        direction: ASC
    markers: number
    indentProperties: true
    cardSize: 200
    columnSize: {}
  - type: table
    name: LastUpdate
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.mtime
        direction: ASC

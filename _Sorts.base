filters:
  and:
    - file.folder.startsWith("Latos - Infusion/Infusion/Ressources/Sort")
views:
  - type: table
    name: Tableau
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.tags
    sort:
      - property: file.name
        direction: ASC

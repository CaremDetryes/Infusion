filters:
  and:
    - file.folder.startsWith("Latos - Infusion/Infusion/Ressources/Sort")
views:
  - type: table
    name: Tableau
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - Nature
      - Coût en mana
      - Temps d'incantation
      - Challenge
      - Degré d'amplification
      - Composante
    sort:
      - property: file.name
        direction: ASC
